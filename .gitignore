# ── Node / JavaScript ─────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
.nest/

# Package managers — lock files generated by non-npm managers
.npm/
.yarn/
yarn.lock
pnpm-lock.yaml

# ── Rust / Soroban ────────────────────────────────────────────────────────────
target/
# Ignore all Cargo.lock files by default …
Cargo.lock
# … except the contracts workspace, which pins the soroban-sdk 26 dependency
# stack. Committing it keeps CI reproducible.
!contracts/Cargo.lock

# ── Test artifacts — auto-generated, must not be committed ───────────────────
coverage/
__snapshots__/
*.snap
junit.xml
test-results/
.nyc_output/
lcov.info
*.lcov
coverage-final.json

# Soroban test snapshots (auto-generated by the soroban-sdk test framework)
test_snapshots/
**/test_snapshots/

# Karma / browser test output
karma-test-results.xml
browser_test_results/

# Vitest / Jest cache and coverage
.vitest-cache/
.jest-cache/
.jest_cache/
jest-coverage/

# Jasmine / Angular test output
jasmine-results/
.karma/

# Playwright / Cypress artifacts
playwright-report/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# ── Build artifacts ───────────────────────────────────────────────────────────
build/
*.js.map
*.d.ts.map
*.wasm
*.tsbuildinfo

# Packed npm tarballs
*.tgz
*.tar.gz

# ── Kiro CLI ──────────────────────────────────────────────────────────────────
.kiro/

# ── Shared package compiled output (source is index.ts) ──────────────────────
shared/index.js
shared/index.d.ts

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Editor temp / backup files
*.bak
*.orig
*.rej
*~

# ── Soroban CLI state and deployment artifacts ────────────────────────────────
.soroban/
.stellar/
contract-ids.testnet.json
scripts/contract-ids.testnet.json
contract-ids.*.json

# ── Docker Compose local overrides ───────────────────────────────────────────
# (The sentinel staging override is intentionally excluded)
docker-compose.override.yml

# ── Runtime data ──────────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Profiling ─────────────────────────────────────────────────────────────────
*.heapsnapshot
*.cpuprofile

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temp files ────────────────────────────────────────────────────────────────
*.tmp
