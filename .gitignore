# ── Node / JavaScript ─────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
.nest/

# Package managers
.npm/
.yarn/
yarn.lock
pnpm-lock.yaml
*.tgz
*.tar.gz

# ── Rust / Soroban ────────────────────────────────────────────────────────────
target/

# Rust/Soroban compiled output
*.wasm

# The contracts workspace pins ed25519-dalek to the soroban-sdk 26 stack;
# commit its lockfile so CI builds don't re-resolve to incompatible versions.
Cargo.lock
!contracts/Cargo.lock

# Kiro CLI
.kiro/

# shared/ package compiled output (source is index.ts)
shared/index.js
shared/index.d.ts

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Soroban CLI state and deployment artefacts ────────────────────────────────
.soroban/
.stellar/
contract-ids.testnet.json
scripts/contract-ids.testnet.json
contract-ids.*.json

# ── Test artifacts (auto-generated, never commit) ─────────────────────────────
# Soroban test snapshots (auto-generated by soroban-sdk test framework)
test_snapshots/
**/test_snapshots/

# Coverage and test output
coverage/
__snapshots__/
*.snap
junit.xml
test-results/
.nyc_output/
lcov.info
*.lcov
coverage-final.json

# Browser test output
karma-test-results.xml
browser_test_results/
.karma/

# Vitest / Jest cache and output
.vitest-cache/
.jest-cache/
.jest_cache/
jest-coverage/

# Jasmine test output
jasmine-results/

# Angular test output (Karma)
karma-test-results.xml

# Playwright / Cypress artifacts
playwright-report/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# ── Build Artifacts ───────────────────────────────────────────────────────────
build/
*.js.map
*.d.ts.map

# TypeScript incremental build cache
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
